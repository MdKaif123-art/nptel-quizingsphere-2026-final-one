rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Notifications for each course
    match /notifications/{course}/notifications/{notifId} {
      allow read: if true; // Anyone can read notifications
      allow write: if request.auth != null; // Any logged-in user can write (add, edit, delete)
    }

    // User Additional Questions for each course
    match /notifications/{course}/additional-questions/{questionId} {
      allow create: if true; // Anyone can post a question
      allow read, delete: if request.auth != null; // Any logged-in user can read and delete
      allow update: if false; // No one can update
    }

    // Admin Additional Questions for each course
    match /notifications/{course}/admin-additional-questions/{questionId} {
      allow read: if true; // Anyone can read admin additional questions
      allow write: if request.auth != null; // Any logged-in user can add/edit/delete
    }

    // Contact Messages
    match /contact-messages/{messageId} {
      allow create: if true; // Anyone can submit a contact form
      allow read, update, delete: if request.auth != null; // Only logged-in users can read, update, or delete
    }
  }
} 